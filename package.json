{
  "name": "juanalmaraz.dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "services": "docker compose up -d --wait && tsx scripts/local-aws.ts",
    "dev": "pnpm services && astro dev",
    "build": "astro build",
    "test": "pnpm services && firebase emulators:exec --only firestore --project demo-juanalmaraz \"vitest run\"",
    "seed": "tsx scripts/seed.ts",
    "e2e": "pnpm services && firebase emulators:exec --only firestore,storage --project demo-juanalmaraz \"playwright test\"",
    "lint": "astro check && eslint .",
    "check": "pnpm lint && pnpm test && pnpm e2e"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/rss": "^4.0.19",
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/client-ssm": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1166.0",
    "@aws-sdk/s3-presigned-post": "^3.1166.0",
    "@shikijs/rehype": "^4.6.0",
    "astro": "^7.4.10",
    "aws-jwt-verify": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "hast-util-to-string": "^3.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/hast": "^3.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "firebase-tools": "^15.35.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
