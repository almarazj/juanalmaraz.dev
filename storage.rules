rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Writes go through the Admin SDK, which bypasses rules; the resume is served by the app.
    match /images/{path=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
