---
import '../styles/prose.css';
import Base from './Base.astro';
import SideIndex from '../components/site/SideIndex.astro';
import type { Post } from '../lib/content/schemas';
import type { Heading } from '../lib/markdown/render';

interface Props {
  post: Post & { id: string };
  html: string;
  headings: Heading[];
  minutes: number;
  prev?: { id: string; title: string; part: number };
  next?: { id: string; title: string; part: number };
}
const { post, html, headings, minutes, prev, next } = Astro.props;
const date = new Date(post.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
});
const sections = [
  {
    id: 'writing', title: 'This post', color: 'var(--c-writing)',
    entries: headings.filter((h) => h.depth === 2).map((h) => ({ id: h.id, title: h.text })),
  },
];
---

<Base title={`${post.title} · Juan Almaraz`} description={post.summary}>
  <div class="progress" aria-hidden="true"><div data-progress></div></div>
  <main class="page with-rail">
    <SideIndex sections={sections}>
      <p class="left"><span data-min-left data-minutes={minutes}>{minutes}</span> min left</p>
    </SideIndex>
    <article id="writing" data-spy-section style="--sc: var(--c-writing)">
      <header class="head">
        <p class="meta">
          <time datetime={new Date(post.publishedAt).toISOString()}>{date}</time> · {minutes} min read
        </p>
        <h1>{post.title}</h1>
        <p class="summary">{post.summary}</p>
      </header>
      <div class="prose" set:html={html} />
      {
        post.series && (
          <nav class="series" aria-label="Series">
            <p class="meta">Part {post.series.part} of {post.series.title}</p>
            <div class="links">
              {prev ? (
                <a href={`/writing/${prev.id}`} rel="prev">
                  <span>Previous, part {prev.part}</span>
                  {prev.title}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a href={`/writing/${next.id}`} rel="next" class="next">
                  <span>Next, part {next.part}</span>
                  {next.title}
                </a>
              )}
            </div>
          </nav>
        )
      }
    </article>
  </main>
</Base>

<style>
  main {
    padding-top: 96px;
  }
  .progress {
    position: fixed;
    inset: 56px 0 auto 0;
    z-index: 11;
    height: 2px;
  }
  .progress div {
    height: 100%;
    background: var(--c-writing);
    transform: scaleX(0);
    transform-origin: left;
  }
  .left {
    margin: 12px 0 0 12px;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .head,
  .series {
    max-width: 68ch;
  }
  .meta {
    margin: 0;
    font: 400 12.5px/1.5 var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--c-writing);
  }
  h1 {
    margin: 8px 0;
    font: 600 32px/1.2 var(--font-sans);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .summary {
    margin: 0 0 32px;
    color: var(--muted);
  }
  .series {
    margin-top: 44px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 12px;
  }
  .links a {
    display: block;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
  }
  .links a:hover {
    border-color: var(--c-writing);
  }
  .links a span {
    display: block;
    font: 400 12px/1.5 var(--font-mono);
    color: var(--muted);
  }
  .links .next {
    grid-column: 2;
    text-align: right;
  }
  @media (max-width: 680px) {
    .links {
      grid-template-columns: 1fr;
    }
    .links .next {
      grid-column: 1;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const left = document.querySelector<HTMLElement>('[data-min-left]');
  const total = Number(left?.dataset.minutes ?? 0);
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 1;
    bar.style.transform = `scaleX(${p})`;
    if (left) left.textContent = String(Math.max(0, Math.ceil(total * (1 - p))));
  };
  let queued = false;
  const schedule = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    }
  };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule);
  update();

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const code = btn.closest('.codeblock')!.querySelector('pre')!;
    btn.addEventListener('click', async () => {
      let label = 'Copied';
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
      } catch {
        // Clipboard refused: select the code so Ctrl+C works.
        getSelection()?.selectAllChildren(code);
        label = 'select it';
      }
      btn.textContent = label;
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    });
  }
</script>
