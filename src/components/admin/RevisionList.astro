---
import type { Revision } from '../../lib/content/repo';

interface Props {
  collection: string;
  id: string;
  revisions: Revision[];
}

const { collection, id, revisions } = Astro.props;
const when = (ms: number) => new Date(ms).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
---

<section class="revisions" aria-labelledby="h-revisions" data-collection={collection} data-id={id}>
  <h2 id="h-revisions">Revisions</h2>
  {revisions.length === 0 && <p class="admin-note">No revisions yet.</p>}
  <ol>
    {
      revisions.map((r, i) => (
        <li>
          <span>
            <time datetime={new Date(r.savedAt).toISOString()}>{when(r.savedAt)}</time>
            <span class="by">{r.savedBy}</span>
          </span>
          {i === 0 ? (
            <span class="current">current</span>
          ) : (
            <button type="button" class="pill" data-restore={r.id}>
              Restore
            </button>
          )}
        </li>
      ))
    }
  </ol>
  <p class="admin-error" role="alert" data-restore-error></p>
</section>

<script>
  const list = document.querySelector<HTMLElement>('.revisions');
  list?.addEventListener('click', async (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-restore]');
    if (!button) return;
    button.disabled = true;
    const res = await fetch('/admin/api/restore', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ collection: list.dataset.collection, id: list.dataset.id, revisionId: button.dataset.restore }),
    });
    if (res.ok) return location.reload();
    button.disabled = false;
    list.querySelector('[data-restore-error]')!.textContent = `Restore failed (${res.status}).`;
  });
</script>

<style>
  h2 {
    margin: 0 0 12px;
    font: 600 13px/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  ol {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font: 400 13px/1.4 var(--font-mono);
  }
  li > span:first-child {
    display: grid;
  }
  .by,
  .current {
    color: var(--faint);
  }
  button {
    cursor: pointer;
  }
</style>
