---
import type { Experience } from '../../lib/content/schemas';
import Entry from './Entry.astro';
import { monthLabel } from './format';
import { tenure } from './tenure';

interface Props {
  items: (Experience & { id: string })[];
  now: Date;
}
const { items, now } = Astro.props;
---

<section id="experience" data-spy-section style="--sc: var(--c-experience); --c: var(--c-experience)">
  <h2 class="section-label">Work experience</h2>
  {
    items.map((x) => (
      <Entry
        id={`exp-${x.id}`}
        logo={x.logo}
        monogram={x.monogram}
        title={x.role}
        period={`${monthLabel(x.start)} - ${x.end ? monthLabel(x.end) : 'now'}`}
        org={x.org}
        url={x.url}
        place={x.place}
        mode={x.mode}
        meta={`${tenure(x.start, x.end, now).years.toFixed(1)} yrs${x.type ? ` · ${x.type}` : ''}`}
        summary={x.summary}
        highlights={(x.highlights ?? '').split('\n').map((h) => h.trim()).filter(Boolean)}
        stack={x.stack}
      />
    ))
  }
</section>

<style>
  section > :global(article:last-of-type) {
    border-bottom: 1px solid var(--line);
  }
</style>
