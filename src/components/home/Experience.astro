---
import type { Experience } from '../../lib/content/schemas';
import { imageProps } from '../../lib/images/url';
import { monthLabel } from './format';
import { tenure } from './tenure';

interface Props {
  items: (Experience & { id: string })[];
  now: Date;
}
const { items, now } = Astro.props;
---

<section id="experience" data-spy-section style="--sc: var(--c-experience); --c: var(--c-experience)">
  <h2 class="section-label">Work experience</h2>
  {
    items.map((x) => {
      const highlights = (x.highlights ?? '').split('\n').map((h) => h.trim()).filter(Boolean);
      return (
        <article id={`exp-${x.id}`} data-spy-entry>
          {x.logo ? (
            <img class="logo" {...imageProps(x.logo, '48px')} alt="" width="48" height="48" loading="lazy" />
          ) : (
            <span class="logo monogram" aria-hidden="true">
              {x.monogram}
            </span>
          )}
          <div class="body">
            <div class="head">
              <h3>{x.role}</h3>
              <p class="period">
                {monthLabel(x.start)} - {x.end ? monthLabel(x.end) : 'now'}
              </p>
            </div>
            <p class="org">
              {x.url ? <a href={x.url}>{x.org}</a> : x.org} · {x.place}
              {x.mode && ` · ${x.mode}`}
            </p>
            <p class="meta">
              {tenure(x.start, x.end, now).years.toFixed(1)} yrs{x.type && ` · ${x.type}`}
            </p>
            {x.summary && <p class="summary">{x.summary}</p>}
            {highlights.length > 0 && (
              <ul class="highlights">
                {highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {x.stack.length > 0 && (
              <ul class="chips" aria-label="Stack">
                {x.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      );
    })
  }
</section>

<style>
  article {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 18px;
    padding-block: 26px;
    border-top: 1px solid var(--line);
  }
  article:last-child {
    border-bottom: 1px solid var(--line);
  }
  .logo {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-card);
    object-fit: cover;
  }
  .monogram {
    display: grid;
    place-items: center;
    background: var(--soft);
    border: 1px solid var(--line);
    color: var(--muted);
    font: 600 13px/1 var(--font-mono);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
  }
  h3 {
    margin: 0;
    font: 600 19px/1.3 var(--font-serif);
    text-wrap: balance;
  }
  .period,
  .meta {
    margin: 0;
    font: 400 12.5px/1.5 var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }
  .period {
    white-space: nowrap;
  }
  .org {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 14.5px;
  }
  .org a {
    color: var(--fg);
    font-weight: 500;
    text-decoration: none;
  }
  .org a:hover {
    text-decoration: underline;
  }
  .summary {
    margin: 12px 0;
  }
  .summary:last-child {
    margin-bottom: 0;
  }
  .highlights {
    display: grid;
    gap: 4px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }
  .highlights:last-child {
    margin-bottom: 0;
  }
  .highlights li {
    position: relative;
    padding-left: 16px;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.68em;
    width: 5px;
    height: 5px;
    background: var(--sc);
  }
  @media (max-width: 560px) {
    article {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
