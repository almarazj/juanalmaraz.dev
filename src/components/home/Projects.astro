---
import type { Project } from '../../lib/content/schemas';
import { imageProps } from '../../lib/images/url';

type Item = Project & { id: string };
interface Props {
  backend: Item[];
  engineering: Item[];
}
const { backend, engineering } = Astro.props;
const boxes = ['API', 'Queue', 'workers', 'DB'];
---

<section id="projects" data-spy-section style="--sc: var(--c-projects)">
  <h2 class="section-label">Projects</h2>

  <div id="proj-backend" class="group" data-spy-entry style="--c: var(--c-projects)">
    <div class="group-head">
      <h3 class="group-title">Backend</h3>
      <div class="nav">
        <button type="button" class="arrow" data-strip-prev aria-label="Previous projects">←</button>
        <button type="button" class="arrow" data-strip-next aria-label="Next projects">→</button>
      </div>
    </div>
    <div class="strip" data-strip role="region" aria-label="Backend projects" tabindex="0">
      {
        backend.map((p) => (
          <article class="card">
              <div class="thumb">
                {p.diagram ? (
                  <img {...imageProps(p.diagram, '132px')} alt={p.diagram.alt} loading="lazy" />
                ) : p.image && !p.confidential ? (
                  <img {...imageProps(p.image, '132px')} alt={p.image.alt} loading="lazy" />
                ) : (
                  <svg viewBox="0 0 132 132" role="img" aria-label="Architecture: API, queue, workers, database">
                    {boxes.map((b, i) => (
                      <g>
                        <rect x="24" y={6 + i * 31} width="84" height="22" rx="4" />
                        <text x="66" y={21 + i * 31}>
                          {b}
                        </text>
                        {i < boxes.length - 1 && <path d={`M66 ${29 + i * 31} v7`} />}
                      </g>
                    ))}
                  </svg>
                )}
              </div>
              <div class="body">
                <div class="title-row">
                  <h4>{p.title}</h4>
                  <span class="year">{p.year}</span>
                  {p.confidential && (
                    <span class="badge" title="Confidential client work">
                      conf.
                    </span>
                  )}
                </div>
                <p class="summary">{p.summary}</p>
                {p.stack.length > 0 && (
                  <ul class="chips" aria-label="Stack">
                    {p.stack.map((s) => (
                      <li class="chip">{s}</li>
                    ))}
                  </ul>
                )}
                {p.links.length > 0 && (
                  <p class="links">
                    {p.links.map((l) => (
                      <a class="pill" href={l.url}>
                        {l.label} ↗
                      </a>
                    ))}
                  </p>
                )}
              </div>
          </article>
        ))
      }
    </div>
  </div>

  <section id="proj-engineering" class="group" data-spy-entry aria-labelledby="eng-title" style="--c: var(--c-engineering)">
    <h3 id="eng-title" class="group-title eng">Earlier engineering work</h3>
    <ul class="eng-list">
      {
        engineering.map((p) => (
          <li>
            {p.image ? <img {...imageProps(p.image, '44px')} alt="" loading="lazy" /> : <span class="ph" />}
            <div>
              <p class="eng-title">
                {p.title} <span class="year">{p.year}</span>
              </p>
              {p.stack.length > 0 && <p class="tags">{p.stack.join(' · ')}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</section>

<style>
  .group + .group {
    margin-top: 32px;
  }
  .group-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .group-title {
    margin: 0;
    font: 600 12.5px/1.4 var(--font-mono);
    color: var(--c);
  }
  .group-title.eng {
    margin-bottom: 12px;
  }
  .nav {
    display: flex;
    gap: 6px;
  }
  .arrow {
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--fg);
    font-size: 15px;
    cursor: pointer;
  }
  .arrow:hover:not(:disabled) {
    border-color: var(--faint);
  }
  .arrow:disabled {
    color: var(--faint);
    cursor: default;
  }
  .strip {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  .card {
    flex: 0 0 min(460px, 88%);
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 16px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .thumb {
    width: 132px;
    height: 132px;
    border-radius: var(--radius-control);
    background: var(--soft);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb svg {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--c);
  }
  .thumb rect {
    fill: color-mix(in srgb, var(--c) 12%, var(--bg));
    stroke: currentColor;
  }
  .thumb text {
    fill: color-mix(in srgb, var(--c) 75%, var(--fg));
    font: 500 10px var(--font-mono);
    text-anchor: middle;
  }
  .thumb path {
    stroke: currentColor;
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }
  h4 {
    margin: 0;
    font: 600 16px/1.35 var(--font-sans);
  }
  .year {
    font: 400 12px/1 var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }
  .badge {
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    font: 500 11px/1.4 var(--font-mono);
    color: var(--muted);
  }
  .summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    margin: 6px 0 10px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
  }
  .links .pill {
    min-height: 28px;
    padding: 2px 10px;
    font-size: 13px;
  }
  .eng-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 12px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .eng-list li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }
  .eng-list img,
  .ph {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-control);
    object-fit: cover;
    background: var(--soft);
    border: 1px solid var(--line);
  }
  .eng-title {
    margin: 0;
    font-weight: 600;
    line-height: 1.35;
  }
  .tags {
    margin: 2px 0 0;
    font: 400 12px/1.4 var(--font-mono);
    color: var(--c);
  }
  @media (max-width: 679px) {
    .card {
      grid-template-columns: 1fr;
    }
    .thumb {
      width: 100%;
      height: 132px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  for (const strip of document.querySelectorAll<HTMLElement>('[data-strip]')) {
    const group = strip.parentElement!;
    const prev = group.querySelector<HTMLButtonElement>('[data-strip-prev]')!;
    const next = group.querySelector<HTMLButtonElement>('[data-strip-next]')!;
    const step = () => (strip.firstElementChild as HTMLElement | null)?.offsetWidth ?? strip.clientWidth;
    const sync = () => {
      prev.disabled = strip.scrollLeft <= 1;
      next.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1;
    };
    prev.addEventListener('click', () => strip.scrollBy({ left: -step() }));
    next.addEventListener('click', () => strip.scrollBy({ left: step() }));
    strip.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  }
</script>
