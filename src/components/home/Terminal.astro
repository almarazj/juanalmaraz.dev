---
import { promptHTML } from './terminal/commands';
import type { TerminalData } from './terminal/data';
import { neofetchHTML } from './terminal/neofetch';
import { frame, REST_ANGLE } from './terminal/spinner';

interface Props {
  data: TerminalData;
}
const { data } = Astro.props;
// Without JS (or before it runs) neofetch still reads as a finished screen.
const now = new Date();
const screen = `<div class="echo">${promptHTML([])}neofetch</div><div class="blk">${neofetchHTML(data.info, now, frame(REST_ANGLE))}</div>`;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="term" data-terminal>
  <div class="sb" data-sb>
    <div class="out" data-out role="log" set:html={screen} />
    <div class="line">
      <span data-ps set:html={promptHTML([])} /><span data-view><span class="cur g">h</span><span class="sug">elp</span></span>
      <input
        class="in"
        data-in
        type="text"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        aria-label="Terminal command, type help to list commands"
      />
    </div>
    <div class="menu" data-menu hidden></div>
  </div>
  <script type="application/json" data-terminal-data set:html={json} />
</div>

<script>
  import { initTerminal } from './terminal/shell';

  for (const root of document.querySelectorAll<HTMLElement>('[data-terminal]')) initTerminal(root);
</script>

<!-- Output is built as HTML strings at runtime, so these rules cannot be scoped. -->
<style is:global>
  .term {
    --t-bg: var(--tty-bg);
    --t-fg: var(--tty-fg);
    --t-dim: var(--tty-dim);
    --t-acc: var(--g-acc);
    --t-ok: var(--g-ok);
    --t-info: var(--g-info);
    --t-err: var(--tty-err);
    --t-mag: var(--tty-mag);
    --t-cyan: var(--tty-cyan);
    --t-sel: var(--tty-sel);
    position: relative;
    display: flex;
    min-width: 0;
    height: 440px;
    border-radius: var(--radius-panel);
    background: var(--t-bg);
    color: var(--t-fg);
    font: 400 13.5px/1.6 var(--font-mono);
    cursor: text;
  }
  .term:has(.in:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .term .sb {
    flex: 1;
    min-width: 0;
    overflow: hidden auto;
    padding: 18px 22px;
    scrollbar-width: thin;
    scrollbar-color: var(--t-sel) transparent;
    transition: background-color 120ms;
  }
  .term.bell .sb {
    background: color-mix(in srgb, var(--t-fg) 7%, var(--t-bg));
  }
  .term .blk,
  .term .echo,
  .term .line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .term .line {
    position: relative;
  }
  /* The real input only collects keys; the line is drawn by [data-view]. */
  .term .in {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    font-size: 16px;
    pointer-events: none;
  }
  .term .cur {
    --cc: var(--t-fg);
  }
  .term .cur.g {
    --cc: var(--t-dim);
    color: var(--t-dim);
  }
  .term.focus .cur {
    background: var(--g-acc);
    color: var(--t-bg);
    animation: term-blink 1.1s steps(1) infinite;
  }
  .term:not(.focus) .cur {
    box-shadow: inset 0 0 0 1px var(--t-dim);
  }
  @keyframes term-blink {
    50% {
      background: transparent;
      color: var(--cc);
    }
  }
  .term .sug {
    color: var(--t-dim);
    cursor: pointer;
  }
  .term .menu {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18ch, 1fr));
    column-gap: 2ch;
    white-space: pre;
  }
  .term .menu span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .term .menu .sel {
    background: var(--t-sel);
  }
  .term a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    text-underline-offset: 2px;
  }
  .term a:hover {
    text-decoration-color: currentColor;
  }
  .term a:focus-visible {
    outline: 2px solid var(--g-acc);
    outline-offset: 1px;
  }
  .term .c-dim { color: var(--t-dim); }
  .term .c-acc { color: var(--t-acc); }
  .term .c-ok { color: var(--t-ok); }
  .term .c-info { color: var(--t-info); }
  .term .c-err { color: var(--t-err); }
  .term .c-mag { color: var(--t-mag); }
  .term .c-cyan { color: var(--t-cyan); }
  .term .b { font-weight: 600; }
  .term .nf {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 4ch;
    padding-block: 4px;
    white-space: normal;
  }
  .term .nf-art {
    width: 32ch;
    color: var(--t-acc);
    font-weight: 600;
    line-height: 1.12;
    white-space: pre;
  }
  .term .nf-info {
    align-self: center;
    min-width: 0;
    white-space: pre-wrap;
  }
  .term .sw {
    display: inline-block;
    width: 3ch;
    height: 1.1em;
    vertical-align: -0.2em;
  }
  .term .sw-dim { background: var(--t-dim); }
  .term .sw-err { background: var(--t-err); }
  .term .sw-ok { background: var(--t-ok); }
  .term .sw-acc { background: var(--t-acc); }
  .term .sw-info { background: var(--t-info); }
  .term .sw-mag { background: var(--t-mag); }
  .term .sw-cyan { background: var(--t-cyan); }
  .term .sw-fg { background: var(--t-fg); }
  @media (max-width: 680px) {
    /* Tall enough for neofetch on a typical phone, never taller than the screen. */
    .term {
      height: min(600px, 85svh);
      font-size: 12.5px;
    }
    .term .sb {
      padding: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .term.focus .cur {
      animation: none;
    }
    .term .sb {
      transition: none;
    }
  }
</style>
