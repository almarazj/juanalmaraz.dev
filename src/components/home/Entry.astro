---
import type { ImageRef } from '../../lib/content/schemas';
import { imageProps } from '../../lib/images/url';

/** One role or degree: logo, serif title with its period on the same line, the organization, then the details. */
interface Props {
  id: string;
  logo?: ImageRef;
  monogram: string;
  title: string;
  period: string;
  org: string;
  url?: string;
  place?: string;
  mode?: string;
  meta?: string;
  summary?: string;
  highlights?: string[];
  stack?: string[];
}
const { id, logo, monogram, title, period, org, url, place, mode, meta, summary, highlights = [], stack = [] } = Astro.props;
---

<article id={id} data-spy-entry>
  {
    logo ? (
      <img class="logo" {...imageProps(logo, '48px')} alt="" width="48" height="48" loading="lazy" />
    ) : (
      <span class="logo monogram" aria-hidden="true">
        {monogram}
      </span>
    )
  }
  <div class="body">
    <div class="head">
      <h3>{title}</h3>
      <p class="period">{period}</p>
    </div>
    <p class="org">
      {url ? <a href={url}>{org}</a> : org}
      {place && ` · ${place}`}
      {mode && ` · ${mode}`}
    </p>
    {meta && <p class="meta">{meta}</p>}
    {summary && <p class="summary">{summary}</p>}
    {
      highlights.length > 0 && (
        <ul class="highlights">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
    <slot />
    {
      stack.length > 0 && (
        <ul class="chips" aria-label="Stack">
          {stack.map((s) => (
            <li class="chip">{s}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  article {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 18px;
    padding-block: 26px;
    border-top: 1px solid var(--line);
  }
  /* The border keeps white logo tiles from dissolving into the light page. */
  .logo {
    box-sizing: border-box;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    object-fit: cover;
  }
  .monogram {
    display: grid;
    place-items: center;
    background: var(--soft);
    color: var(--muted);
    font: 600 13px/1 var(--font-mono);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
  }
  h3 {
    margin: 0;
    font: 600 19px/1.3 var(--font-serif);
    text-wrap: balance;
  }
  .period,
  .meta {
    margin: 0;
    font: 400 12.5px/1.5 var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }
  .period {
    white-space: nowrap;
  }
  .org {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 14.5px;
  }
  .org a {
    color: var(--fg);
    font-weight: 500;
    text-decoration: none;
  }
  .org a:hover {
    text-decoration: underline;
  }
  .summary {
    margin: 12px 0;
  }
  .summary:last-child {
    margin-bottom: 0;
  }
  .highlights {
    display: grid;
    gap: 4px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }
  .highlights:last-child {
    margin-bottom: 0;
  }
  .highlights li {
    position: relative;
    padding-left: 16px;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.68em;
    width: 5px;
    height: 5px;
    background: var(--sc);
  }
  @media (max-width: 560px) {
    article {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
