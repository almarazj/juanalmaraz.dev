---
import type { About } from '../../lib/content/schemas';
import { imageProps } from '../../lib/images/url';
import PhotoStack from './PhotoStack.astro';
import { hostLabel } from './format';

interface Props {
  about: About;
  bioHtml: string;
}
const { about, bioHtml } = Astro.props;
const photos = about.photos.map((p) => ({ ...imageProps(p.image, '(min-width: 640px) 280px, 70vw'), alt: p.image.alt, caption: p.caption }));

// 24px stroke icons; the color says what kind of answer it is.
const icons: Record<string, { color: string; svg: string }> = {
  book: { color: 'var(--c-writing)', svg: '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>' },
  'book-open': { color: 'var(--c-writing)', svg: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>' },
  film: { color: 'var(--c-about)', svg: '<rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5"/>' },
  music: { color: 'var(--c-projects)', svg: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>' },
  flag: { color: 'var(--c-experience)', svg: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><path d="M4 22v-7"/>' },
  ball: { color: 'var(--c-education)', svg: '<circle cx="12" cy="12" r="10"/><path d="m12 7 4.5 3.3-1.7 5.2H9.2L7.5 10.3z"/><path d="M12 7V2M16.5 10.3l4.8-1.6M14.8 15.5l2.9 4M9.2 15.5l-2.9 4M7.5 10.3 2.7 8.7"/>' },
};
const fallback = { color: 'var(--c-about)', svg: '<circle cx="12" cy="12" r="9"/>' };
---

<section id="about" data-spy-section style="--sc: var(--c-about)">
  <h2 class="section-label">About</h2>
  <div id="about-me" class:list={["intro", { solo: photos.length === 0 }]} data-spy-entry>
    {photos.length > 0 && <PhotoStack photos={photos} />}
    <div class="bio" set:html={bioHtml} />
  </div>

  <div id="about-questions" data-spy-entry>
    <h3 class="sub">Quick questions</h3>
    <dl class="qa">
      {
        about.questions.map((q) => {
          const icon = icons[q.icon] ?? fallback;
          return (
            <div class="row">
              <dt>{q.q}</dt>
              <dd>
                <span class="answer">
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    style={`color: ${icon.color}`}
                    set:html={icon.svg}
                  />
                  {q.a}
                </span>
                <span class="detail">
                  {q.detail}
                  {q.link && (
                    <>
                      {' · '}
                      <a href={q.link}>{hostLabel(q.link)} ↗</a>
                    </>
                  )}
                </span>
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .intro.solo {
    grid-template-columns: 1fr;
  }
  .bio :global(p) {
    margin: 0 0 12px;
  }
  .bio :global(p:last-child) {
    margin-bottom: 0;
  }
  .sub {
    margin: 40px 0 8px;
    font: 600 12.5px/1.4 var(--font-mono);
    color: var(--sc);
  }
  .qa {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 4px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font: 400 12.5px/1.9 var(--font-mono);
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  .answer {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 19px/1.35 var(--font-serif);
  }
  .answer svg {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .detail {
    display: block;
    margin: 2px 0 0 30px;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 679px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
