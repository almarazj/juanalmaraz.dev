---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="Sign in">
  <section class="login">
    <h1>Sign in</h1>
    <p class="admin-note">Only the site owner's Google account can open the admin.</p>
    <a class="pill primary" href="/admin/api/signin">Sign in with Google</a>
  </section>
</Admin>

<style>
  .login {
    display: grid;
    justify-items: start;
    gap: 16px;
    max-width: 420px;
    margin: 64px auto 0;
  }
  h1 {
    margin: 0;
    font: 600 28px/1.2 var(--font-sans);
  }
  .primary {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
</style>
